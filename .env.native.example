# npm run setup:env creates .env.native without changing the base implementation's .env.
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
REDIS_URL=redis://127.0.0.1:6379
REDIS_NAMESPACE=native-v1
HIS_ENABLED=false
# Enables image mode for the built-in strict policy; standard remains pow.
CAPTCHA_IMAGE_ENABLED=false
CAPTCHA_IMAGE_LENGTH=5
CAPTCHA_IMAGE_TTL_SECONDS=120
# First answers across fresh images, per IP / 60 seconds (not guesses on one image).
CAPTCHA_IMAGE_RATE_LIMIT=10
CHALLENGE_KEYS_JSON={"active":"c1","keys":{"c1":"replace-challenge-secret"}}
TOKEN_KEYS_JSON={"active":"t1","keys":{"t1":"replace-token-secret"}}
INTERNAL_CLIENTS_JSON={"business":{"secret":"replace-service-secret","sites":["example"]}}
SITES_JSON={"example":{"defaultAction":"submit_form","actions":{"submit_form":"standard","sensitive":"strict"},"origins":["http://localhost:3000","http://127.0.0.1:3000"]}}
# Optional POLICIES_JSON replaces the complete server policy map. See docs/architecture.md.
