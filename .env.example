# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-characters
HOST=127.0.0.1
PORT=3001
# Exact frontend origins, comma-separated. Empty value disables cross-origin access.
CORS_ORIGINS=http://localhost:3000
SESSION_TTL_SECONDS=3600
CHALLENGE_TTL_SECONDS=120
# Difficulty: random counter from 20 to 80, PBKDF2 iterations per attempt.
POW_COST=1000
# image: PoW + mandatory characters from an image; pow: original PoW-only mode.
CAPTCHA_MODE=image
LOG_LEVEL=info
