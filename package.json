{
  "name": "altcha-poc-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup:env": "node scripts/setup-env.mjs",
    "test:browser": "tsx --test --test-concurrency=1 test/browser/*.test.ts",
    "check": "npm run typecheck && npm test && npm run test:browser && npm run build",
    "demo:business": "tsx examples/business.ts",
    "demo:frontend": "tsx examples/frontend.ts",
    "test:browser:interactive": "tsx scripts/browser-harness.ts",
    "test:retry:interactive": "tsx scripts/retry-harness.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@napi-rs/canvas": "1.1.0",
    "altcha-lib": "2.8.0",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "jose": "6.2.14",
    "redis": "6.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "altcha": "3.5.0",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "Native ALTCHA 3.5.0 CAPTCHA MS with Redis replay protection"
}
