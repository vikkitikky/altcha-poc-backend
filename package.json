{
  "name": "altcha-poc-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup:env": "node scripts/setup-env.mjs",
    "demo:security": "tsx scripts/security-demo.ts",
    "probe:server-signature": "tsx scripts/server-signature-probe.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@napi-rs/canvas": "1.0.13",
    "altcha-lib": "2.7.0",
    "dotenv": "18.0.8",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
